---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WeRemoteU</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #0f172a;
        color: white;
      }

      .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px;
      }

      h1 {
        font-size: 60px;
        margin-bottom: 20px;
      }

      h2 {
        font-size: 32px;
        color: #38bdf8;
        margin-bottom: 30px;
      }

      p {
        font-size: 22px;
        max-width: 700px;
        margin: auto;
        line-height: 1.6;
      }

      .button {
        display: inline-block;
        margin-top: 40px;
        background: #22c55e;
        color: white;
        text-decoration: none;
        padding: 18px 36px;
        border-radius: 10px;
        font-size: 20px;
        font-weight: bold;
      }

      .button:hover {
        background: #16a34a;
      }
    </style>
  </head>

  <body>
    <section class="hero">
      <div>
        <h1>Build Your Career From Anywhere</h1>

        <h2>Land Your First Remote Job</h2>

        <p>
          Learn the skills, resume strategies, interview techniques,
          networking, and AI tools used by professionals to land amazing
          remote careers from anywhere in the world.
        </p>

        <a class="button" href="#">
          Join the Waitlist
        </a>
      </div>
    </section>
  </body>
</html>
