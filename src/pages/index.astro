---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WeRemoteU | Build Your Career From Anywhere</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg,#0f172a,#1e3a8a);
        color: white;
      }

      nav {
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:25px 10%;
      }

      nav h2{
        color:#38bdf8;
      }

      nav a{
        color:white;
        text-decoration:none;
        margin-left:25px;
      }

      .hero{
        min-height:85vh;
        display:flex;
        align-items:center;
        justify-content:center;
        text-align:center;
        padding:40px;
      }

      .hero-content{
        max-width:900px;
      }

      h1{
        font-size:64px;
        line-height:1.1;
        margin-bottom:20px;
      }

      h3{
        font-size:32px;
        color:#38bdf8;
        margin-bottom:25px;
      }

      p{
        font-size:22px;
        line-height:1.7;
        color:#d1d5db;
      }

      .buttons{
        margin-top:40px;
      }

      .btn{
        display:inline-block;
        padding:18px 36px;
        border-radius:10px;
        text-decoration:none;
        font-weight:bold;
        margin:10px;
      }

      .primary{
        background:#22c55e;
        color:white;
      }

      .secondary{
        border:2px solid white;
        color:white;
      }

      .section{
        padding:90px 10%;
        background:white;
        color:#111827;
      }

      .section h2{
        text-align:center;
        font-size:42px;
        margin-bottom:50px;
      }

      .grid{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
        gap:25px;
      }

      .card{
        background:#f3f4f6;
        padding:30px;
        border-radius:15px;
      }

      .card h3{
        color:#1e3a8a;
        margin-bottom:15px;
        font-size:24px;
      }

      footer{
        text-align:center;
        padding:40px;
        background:#0f172a;
      }
    </style>
  </head>

  <body>

    <nav>
      <h2>WeRemoteU</h2>

      <div>
        <a href="#">Home</a>
        <a href="#">Program</a>
        <a href="#">FAQ</a>
      </div>
    </nav>

    <section class="hero">

      <div class="hero-content">

        <h1>Build Your Career From Anywhere</h1>

        <h3>Land Your First Remote Job</h3>

        <p>
          Learn practical skills, resume strategies, interview techniques,
          networking methods, and AI tools that help professionals land
          amazing remote careers from anywhere in the world.
        </p>

        <div class="buttons">
          <a class="btn primary" href="https://docs.google.com/forms/d/e/1FAIpQLSe-M_W6fD1xq6KOUKzcDc9-6E4OPB8yuw6jPzoyDxtvtsXLew/viewform" target="_blank">Join the Waitlist</a>
          <a class="btn secondary" href="#learn">Learn More</a>
        </div>

      </div>

    </section>

    <section id="learn" class="section">

      <h2>What You'll Learn</h2>

      <div class="grid">

        <div class="card">
          <h3>Resume</h3>
          <p>Create a resume that gets interviews.</p>
        </div>

        <div class="card">
          <h3>LinkedIn</h3>
          <p>Optimize your profile so recruiters find you.</p>
        </div>

        <div class="card">
          <h3>Interviewing</h3>
          <p>Master remote interviews with confidence.</p>
        </div>

        <div class="card">
          <h3>AI Tools</h3>
          <p>Use AI to work smarter during your job search.</p>
        </div>

      </div>

    </section>

    <footer>

      <h3>WeRemoteU</h3>

      <p>Helping people build careers from anywhere.</p>

    </footer>

  </body>
</html>
